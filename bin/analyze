#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/../vendor/autoload.php';

use TestQualityAnalyzer\Analyzer;
use TestQualityAnalyzer\AnalysisResult;
use TestQualityAnalyzer\Baseline;
use TestQualityAnalyzer\Issue;
use TestQualityAnalyzer\Visitor\AssertionCountVisitor;
use TestQualityAnalyzer\Visitor\AssertionRouletteVisitor;
use TestQualityAnalyzer\Visitor\ConditionalTestLogicVisitor;
use TestQualityAnalyzer\Visitor\ConstructorInitializationVisitor;
use TestQualityAnalyzer\Visitor\EmptyTestVisitor;
use TestQualityAnalyzer\Visitor\ExceptionHandlingVisitor;
use TestQualityAnalyzer\Visitor\InterfaceTestingVisitor;
use TestQualityAnalyzer\Visitor\LongTestVisitor;
use TestQualityAnalyzer\Visitor\MagicNumberTestVisitor;
use TestQualityAnalyzer\Visitor\RedundantAssertionVisitor;
use TestQualityAnalyzer\Visitor\RedundantPrintVisitor;
use TestQualityAnalyzer\Visitor\MysteryGuestVisitor;
use TestQualityAnalyzer\Visitor\RottenGreenTestVisitor;
use TestQualityAnalyzer\Visitor\SleepyTestVisitor;

// Constants
const DEFAULT_BASELINE_FILENAME = '.tq-baseline.json';

// Parse arguments
$args = array_slice($argv, 1);
$directory = null;
$format = 'text';
$baselinePaths = [];
$generateBaseline = false;
$forceGenerate = false;
$addToBaselinePath = null;
$showHelp = false;
$listTypes = false;
$onlyTypes = null;
$reason = '';

foreach ($args as $arg) {
    if ($arg === '--help' || $arg === '-h') {
        $showHelp = true;
    } elseif ($arg === '--list-types') {
        $listTypes = true;
    } elseif ($arg === '--generate-baseline') {
        $generateBaseline = true;
    } elseif ($arg === '--force') {
        $forceGenerate = true;
    } elseif ($arg === '--baseline') {
        // --baseline with no value uses default filename
        $baselinePaths[] = DEFAULT_BASELINE_FILENAME;
    } elseif (str_starts_with($arg, '--baseline=')) {
        $baselineArg = substr($arg, 11);
        if ($baselineArg === '') {
            // --baseline= (empty value) uses default filename
            $baselinePaths[] = DEFAULT_BASELINE_FILENAME;
        } else {
            // Support both multiple --baseline flags and comma-separated paths
            $paths = array_map('trim', explode(',', $baselineArg));
            $baselinePaths = array_merge($baselinePaths, $paths);
        }
    } elseif ($arg === '--add-to-baseline') {
        // --add-to-baseline with no value uses default filename
        $addToBaselinePath = DEFAULT_BASELINE_FILENAME;
    } elseif (str_starts_with($arg, '--add-to-baseline=')) {
        $addToBaselineArg = substr($arg, 18);
        // --add-to-baseline= (empty value) uses default filename
        $addToBaselinePath = $addToBaselineArg === '' ? DEFAULT_BASELINE_FILENAME : $addToBaselineArg;
    } elseif (str_starts_with($arg, '--format=')) {
        $format = substr($arg, 9);
    } elseif (str_starts_with($arg, '--only=')) {
        $typesStr = substr($arg, 7);
        $onlyTypes = array_map('trim', explode(',', $typesStr));
    } elseif (str_starts_with($arg, '--reason=')) {
        $reason = substr($arg, 9);
    } elseif (!str_starts_with($arg, '-')) {
        $directory = $arg;
    }
}

if ($showHelp || ($directory === null && !$listTypes)) {
    echo <<<HELP
Test Quality Analyzer - AST-based test quality detection

Usage: analyze <directory> [options]

Arguments:
  directory              Path to directory containing test files

Options:
  --format=<format>      Output format: text (default) or json
  --baseline[=<path>]    Baseline file path (default: .tq-baseline.json in scan directory)
                         Can be used multiple times or comma-separated for filtering
  --generate-baseline    Generate NEW baseline JSON (refuses if file exists, use --force to override)
  --force                Allow --generate-baseline to overwrite existing baseline file
  --add-to-baseline[=<path>]  Add new issues to existing baseline (default: .tq-baseline.json)
  --only=<types>         Comma-separated smell types to detect (runs only those detectors)
  --reason=<text>        REQUIRED: Reason text for baseline entries (--generate-baseline or --add-to-baseline)
  --list-types           List available smell types and exit
  --help, -h             Show this help message

Examples:
  analyze /code/test
  analyze /code/test --format=json
  analyze /code/test --only=assertion_roulette,no_assertions
  analyze /code/test --generate-baseline --baseline --reason="Initial baseline for legacy tests"
  analyze /code/test --generate-baseline --baseline --reason="reason" --only=no_assertions
  analyze /code/test --baseline
  analyze /code/test --baseline=.baseline-no-assertions.json --baseline=.baseline-magic-numbers.json
  analyze /code/test --add-to-baseline --only=no_assertions --reason="Mock expectations count as assertions"
  analyze --list-types

HELP;
    exit($showHelp ? 0 : 1);
}

// All available visitors with their types
$allVisitors = [
    new AssertionCountVisitor(),
    new AssertionRouletteVisitor(),
    new ConstructorInitializationVisitor(),
    new EmptyTestVisitor(),
    new SleepyTestVisitor(),
    new RedundantPrintVisitor(),
    new ExceptionHandlingVisitor(),
    new InterfaceTestingVisitor(),
    // new ConditionalTestLogicVisitor(),
    new MagicNumberTestVisitor(),
    new RedundantAssertionVisitor(),
    new RottenGreenTestVisitor(),
    new MysteryGuestVisitor(),
    new LongTestVisitor(),
];

// Set up analyzer with visitors (filtered by --only if specified)
$analyzer = new Analyzer();
foreach ($allVisitors as $visitor) {
    // If --only is specified, only add visitors for those types
    if ($onlyTypes === null || in_array($visitor->getType(), $onlyTypes, true)) {
        $analyzer->addVisitor($visitor);
    }
}

// List types if requested (no directory needed)
if ($listTypes) {
    echo "Available smell types:\n\n";
    foreach ($allVisitors as $visitor) {
        printf("  %-25s %s\n", $visitor->getType(), $visitor->getName());
    }
    echo "\nUse with --only=<type> to run only specific detectors.\n";
    exit(0);
}

if (!is_dir($directory)) {
    fprintf(STDERR, "Error: Directory '%s' not found\n", $directory);
    exit(1);
}

// Helper to resolve baseline path relative to scan directory
$resolveBaselinePath = function (string $path) use ($directory): string {
    // If path is absolute, use as-is
    if (str_starts_with($path, '/')) {
        return $path;
    }
    // Otherwise, make relative to scan directory
    return rtrim($directory, '/') . '/' . $path;
};

// Run analysis
$result = $analyzer->analyzeDirectory($directory);

// Generate baseline if requested
if ($generateBaseline) {
    // Reason is required for baseline generation
    if ($reason === '') {
        fprintf(STDERR, "Error: --reason is required when generating a baseline.\n");
        fprintf(STDERR, "Provide a reason explaining why these issues are acceptable.\n");
        fprintf(STDERR, "\nExample:\n");
        fprintf(STDERR, "  --reason=\"PHPUnit mock expectations count as assertions at runtime\"\n");
        exit(1);
    }

    // If --baseline was provided, check if file already exists
    if (count($baselinePaths) > 0) {
        $outputPath = $resolveBaselinePath($baselinePaths[0]);

        // Refuse to overwrite existing baseline unless --force is specified
        if (file_exists($outputPath) && !$forceGenerate) {
            fprintf(STDERR, "Error: Baseline file '%s' already exists.\n", $outputPath);
            fprintf(STDERR, "\n");
            fprintf(STDERR, "To add new issues to the existing baseline, use:\n");
            fprintf(STDERR, "  --add-to-baseline\n");
            fprintf(STDERR, "\n");
            fprintf(STDERR, "To completely regenerate (WARNING: loses existing entries), use:\n");
            fprintf(STDERR, "  --generate-baseline --force\n");
            exit(1);
        }

        // Issues already filtered by --only (only selected detectors ran)
        $baselineContent = Baseline::generate($result->issues, null, $reason);

        $bytesWritten = file_put_contents($outputPath, $baselineContent);
        if ($bytesWritten === false) {
            fprintf(STDERR, "Error: Failed to write baseline to '%s'\n", $outputPath);
            exit(1);
        }
        fprintf(STDERR, "Generated baseline with %d issue(s) at %s\n",
            count($result->issues), $outputPath);
        exit(0);
    }

    // No --baseline specified, output to stdout (legacy behavior)
    // Issues already filtered by --only (only selected detectors ran)
    $baselineContent = Baseline::generate($result->issues, null, $reason);
    echo $baselineContent;
    exit(0);
}

// Add to existing baseline if requested
if ($addToBaselinePath !== null) {
    // Reason is required for adding to baseline
    if ($reason === '') {
        fprintf(STDERR, "Error: --reason is required when adding issues to a baseline.\n");
        fprintf(STDERR, "Provide a reason explaining why these issues are acceptable.\n");
        fprintf(STDERR, "\nExample:\n");
        fprintf(STDERR, "  --reason=\"Integration tests access database fixtures directly\"\n");
        exit(1);
    }

    $resolvedAddPath = $resolveBaselinePath($addToBaselinePath);

    // Issues already filtered by --only (only selected detectors ran)
    $issuesToAdd = $result->issues;

    // Validate that the parent directory exists and is writable
    $dir = dirname($resolvedAddPath);
    if ($dir !== '.' && !is_dir($dir)) {
        fprintf(STDERR, "Error: Directory '%s' does not exist\n", $dir);
        exit(1);
    }

    // Load existing baseline or create new one
    if (file_exists($resolvedAddPath)) {
        $baseline = Baseline::fromFile($resolvedAddPath);
    } else {
        $baseline = new Baseline([]);
    }

    // Merge new issues with optional reason
    $merged = $baseline->merge($issuesToAdd, $reason);

    // Write back to file
    $bytesWritten = file_put_contents($resolvedAddPath, $merged->toJson());
    if ($bytesWritten === false) {
        fprintf(STDERR, "Error: Failed to write baseline file to '%s'\n", $resolvedAddPath);
        exit(1);
    }

    fprintf(STDERR, "Added %d issue(s) to baseline at %s\n", count($issuesToAdd), $resolvedAddPath);
    exit(0);
}

// Apply baseline filtering if provided
$baselinedCount = 0;
if (count($baselinePaths) > 0) {
    // Load all baseline files (resolve paths relative to scan directory)
    $baselines = [];
    foreach ($baselinePaths as $path) {
        $resolvedPath = $resolveBaselinePath($path);
        if (!file_exists($resolvedPath)) {
            fprintf(STDERR, "Error: Baseline file '%s' not found\n", $resolvedPath);
            exit(1);
        }
        $baselines[] = Baseline::fromFile($resolvedPath);
    }

    // Merge all baselines into the first one
    $mergedBaseline = $baselines[0];
    if (count($baselines) > 1) {
        $mergedBaseline = $mergedBaseline->mergeBaselines(array_slice($baselines, 1));
    }

    $filteredIssues = $mergedBaseline->filter($result->issues);
    $baselinedCount = count($result->issues) - count($filteredIssues);

    $result = new AnalysisResult(
        filesScanned: $result->filesScanned,
        testsFound: $result->testsFound,
        issues: $filteredIssues,
        checksRun: $result->checksRun,
    );
}

// Output results
$output = match ($format) {
    'json' => $result->toJson(),
    default => $result->toText(),
};

// Show baselined count if baseline was applied
if ($baselinedCount > 0) {
    $output .= sprintf("Baselined issues ignored: %d\n", $baselinedCount);
}

echo $output;

exit($result->hasIssues() ? 1 : 0);
